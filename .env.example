# Cobalt Workbench - Environment Configuration Template
# Copy to .env and fill in values. NEVER commit real secrets.

# Application
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=cobalt
KEYCLOAK_CLIENT_ID=cobalt-backend
KEYCLOAK_CLIENT_SECRET=dev-secret-change-in-production
OIDC_ISSUER=http://localhost:8080/realms/cobalt
OIDC_AUDIENCE=cobalt-api
OIDC_JWKS_URL=http://localhost:8080/realms/cobalt/protocol/openid-connect/certs

# CORS
CORS_ORIGINS=http://localhost:3080

# ACP (Agent Context Protocol)
ACP_ENABLED=true
ACP_DEFAULT_WINDOW_TOKENS=100000
ACP_COMPRESSION_TARGET_RATIO=0.2
ACP_FOLD_THRESHOLD_TOKENS=80000

# Request body limits (bytes)
BODY_LIMIT_RECEIVE=104857600
BODY_LIMIT_DECODED=209715200
BODY_LIMIT_OUTBOUND=104857600

# LLM Provider (opt-in, advisory explanations only)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Frontend
VITE_API_BASE=http://localhost:8787